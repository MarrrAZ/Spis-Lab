# Salin file ini menjadi .env.local lalu isi dengan nilai dari project Supabase Anda
# Settings -> API di dashboard Supabase

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-public-key-di-sini

# PENTING: service role key BERSIFAT RAHASIA, jangan pernah taruh di kode
# frontend / commit ke GitHub publik. Hanya dipakai di server (lib/supabase/admin.js)
# untuk fitur "Kelola Akun Asisten".
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
